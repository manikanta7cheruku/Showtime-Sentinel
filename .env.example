# ---------------------------------------------------------------------------
# Copy to .env  ->  cp .env.example .env     (.env is git-ignored, never push it)
# ---------------------------------------------------------------------------

# --- Telegram -------------------------------------------------------------
# From @BotFather. Leave blank to run in console-only mode.
TELEGRAM_BOT_TOKEN=
# Where notifications are sent. Get it from @userinfobot or /start then /status.
TELEGRAM_CHAT_ID=
# Comma-separated numeric user IDs allowed to issue bot commands.
# EMPTY = NOBODY is authorised (fail-closed). See README "Security".
ALLOWED_TELEGRAM_USER_IDS=

# --- Modes ----------------------------------------------------------------
# TEST_MODE forces the fake source everywhere, whatever a watch says.
TEST_MODE=true
# DRY_RUN prints notifications to the console instead of sending them.
DRY_RUN=true

# --- Storage & logging ----------------------------------------------------
DATABASE_PATH=data/monitor.db
LOG_LEVEL=INFO
LOG_FILE=data/logs/monitor.log

# --- Polling --------------------------------------------------------------
DEFAULT_POLL_INTERVAL_SECONDS=60
MIN_POLL_INTERVAL_SECONDS=30
FETCH_TIMEOUT_SECONDS=30
MAX_RETRIES=3
BACKOFF_BASE_SECONDS=5
BACKOFF_MAX_SECONDS=300
MAX_CONCURRENT_CHECKS=4
ERROR_NOTIFY_THRESHOLD=3
RENOTIFY_COOLDOWN_SECONDS=3600

# --- Real BookMyShow adapter (OFF by default; read README first) ----------
ENABLE_BOOKMYSHOW_SOURCE=false
BOOKMYSHOW_MIN_INTERVAL_SECONDS=300
BOOKMYSHOW_HEADLESS=true
RESPECT_ROBOTS_TXT=true

# --- Optional dashboard ---------------------------------------------------
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8765
